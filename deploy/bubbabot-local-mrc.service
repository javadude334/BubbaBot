[Unit]
Description=BubbaBot - private LAN Go MRC gateway adapter
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=bubbabot
Group=bubbabot
WorkingDirectory=/opt/bubbabot
EnvironmentFile=/etc/bubbabot/openai.env
Environment=LOCAL_MRC_HOST=192.168.150.58
Environment=LOCAL_MRC_PORT=5000
ExecStart=/opt/bubbabot/.venv/bin/python -u -m bubbabot.lan_mrc_adapter
Restart=always
RestartSec=10
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true
UMask=0077

[Install]
WantedBy=multi-user.target
